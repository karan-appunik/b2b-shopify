# admin-frontend (Shopify embedded app). Copy to .env and fill in. Never commit .env.

# From the Shopify Partner Dashboard (app > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=

# backend-api (must be running). Local default shown.
BACKEND_API_URL=http://localhost:5000
# Must match INTERNAL_API_KEY in backend-api/.env
BACKEND_INTERNAL_API_KEY=

# merchant-panel address opened by the "Open Dashboard" button.
# Local default shown; use the live URL when deployed.
MERCHANT_PANEL_URL=http://localhost:3001

# Optional, local debugging only
# DEBUG_SHOPIFY_SHOP=
# DEBUG_SHOPIFY_ACCESS_TOKEN=

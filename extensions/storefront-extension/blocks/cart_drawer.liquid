<div id="sparklayer-cart-drawer-root"
     data-sparklayer-cart-drawer
     data-proxy-url="/apps/sparklayer/variant-search"
     data-address-proxy-url="/apps/sparklayer/customer-address"
     data-checkout-proxy-url="/apps/sparklayer/checkout"
     data-payment-terms-proxy-url="/apps/sparklayer/payment-terms"
     data-order-detail-proxy-url="/apps/sparklayer/order-detail"
     data-orders-proxy-url="/apps/sparklayer/orders"
     data-variant-pricing-proxy-url="/apps/sparklayer/variant-pricing"
     data-customer-id="{% if customer %}{{ customer.id }}{% endif %}"
     data-has-customer="{% if customer %}true{% else %}false{% endif %}"
     data-customer-email="{% if customer %}{{ customer.email }}{% endif %}"
     data-customer-name="{% if customer %}{{ customer.name }}{% endif %}"
     data-money-format="{{ shop.money_format }}"
     data-i18n-title="{{ 'cartDrawer.title' | t }}"
     data-i18n-my-account="{{ 'cartDrawer.myAccount' | t }}"
     data-i18n-expand="{{ 'cartDrawer.expand' | t }}"
     data-i18n-minimise="{{ 'cartDrawer.minimise' | t }}"
     data-i18n-step1="{{ 'cartDrawer.step1' | t }}"
     data-i18n-step2="{{ 'cartDrawer.step2' | t }}"
     data-i18n-step3="{{ 'cartDrawer.step3' | t }}"
     data-i18n-step4="{{ 'cartDrawer.step4' | t }}"
     data-i18n-search-placeholder="{{ 'cartDrawer.searchPlaceholder' | t }}"
     data-i18n-empty="{{ 'cartDrawer.empty' | t }}"
     data-i18n-search-empty="{{ 'cartDrawer.searchEmpty' | t }}"
     data-i18n-subtotal="{{ 'cartDrawer.subtotal' | t }}"
     data-i18n-line="{{ 'cartDrawer.line' | t }}"
     data-i18n-lines="{{ 'cartDrawer.lines' | t }}"
     data-i18n-item="{{ 'cartDrawer.item' | t }}"
     data-i18n-items="{{ 'cartDrawer.items' | t }}"
     data-i18n-checkout="{{ 'cartDrawer.checkout' | t }}"
     data-i18n-tax-note="{{ 'cartDrawer.taxNote' | t }}"
     data-i18n-per-unit="{{ 'cartDrawer.perUnit' | t }}"
     data-i18n-msrp="{{ 'cartDrawer.msrp' | t }}"
     data-i18n-close="{{ 'cartDrawer.close' | t }}"
     data-i18n-remove="{{ 'cartDrawer.remove' | t }}"
     data-i18n-additional-info="{{ 'cartDrawer.additionalInfo' | t }}"
     data-i18n-order-notes="{{ 'cartDrawer.orderNotes' | t }}"
     data-i18n-shipping-address="{{ 'cartDrawer.shippingAddress' | t }}"
     data-i18n-no-addresses="{{ 'cartDrawer.noAddresses' | t }}"
     data-i18n-continue="{{ 'cartDrawer.continue' | t }}"
     data-i18n-add-new-address="{{ 'cartDrawer.addNewAddress' | t }}"
     data-i18n-edit-addresses-prefix="{{ 'cartDrawer.editAddressesPrefix' | t }}"
     data-i18n-your-account="{{ 'cartDrawer.yourAccount' | t }}"
     data-i18n-shipping-tax-note="{{ 'cartDrawer.shippingTaxNote' | t }}"
     data-i18n-add-new-address-title="{{ 'cartDrawer.addNewAddressTitle' | t }}"
     data-i18n-cancel="{{ 'cartDrawer.cancel' | t }}"
     data-i18n-first-name="{{ 'cartDrawer.firstName' | t }}"
     data-i18n-last-name="{{ 'cartDrawer.lastName' | t }}"
     data-i18n-company="{{ 'cartDrawer.company' | t }}"
     data-i18n-line1="{{ 'cartDrawer.line1' | t }}"
     data-i18n-line2="{{ 'cartDrawer.line2' | t }}"
     data-i18n-city="{{ 'cartDrawer.city' | t }}"
     data-i18n-zip-code="{{ 'cartDrawer.zipCode' | t }}"
     data-i18n-phone="{{ 'cartDrawer.phone' | t }}"
     data-i18n-save-to-address-book="{{ 'cartDrawer.saveToAddressBook' | t }}"
     data-i18n-continue-use-address="{{ 'cartDrawer.continueUseAddress' | t }}"
     data-i18n-address-save-error="{{ 'cartDrawer.addressSaveError' | t }}"
     data-i18n-checkout-error="{{ 'cartDrawer.checkoutError' | t }}"
     data-i18n-shipping-method="{{ 'cartDrawer.shippingMethod' | t }}"
     data-i18n-shipping-calculated-note="{{ 'cartDrawer.shippingCalculatedNote' | t }}"
     data-i18n-payment-method="{{ 'cartDrawer.paymentMethod' | t }}"
     data-i18n-pay-advance="{{ 'cartDrawer.payAdvance' | t }}"
     data-i18n-pay-net30="{{ 'cartDrawer.payNet30' | t }}"
     data-i18n-pay-now="{{ 'cartDrawer.payNow' | t }}"
     data-i18n-charged-immediately="{{ 'cartDrawer.chargedImmediately' | t }}"
     data-i18n-continue-to-checkout="{{ 'cartDrawer.continueToCheckout' | t }}"
     data-i18n-order-complete-title="{{ 'cartDrawer.orderCompleteTitle' | t }}"
     data-i18n-order-complete-message="{{ 'cartDrawer.orderCompleteMessage' | t }}"
     data-i18n-view-order="{{ 'cartDrawer.viewOrder' | t }}"
     data-i18n-order-status="{{ 'cartDrawer.orderStatus' | t }}"
     data-i18n-order-payment-method="{{ 'cartDrawer.orderPaymentMethod' | t }}"
     data-i18n-order-shipping-method="{{ 'cartDrawer.orderShippingMethod' | t }}"
     data-i18n-order-shipping-address="{{ 'cartDrawer.orderShippingAddress' | t }}"
     data-i18n-order-shipping="{{ 'cartDrawer.orderShipping' | t }}"
     data-i18n-order-tax="{{ 'cartDrawer.orderTax' | t }}"

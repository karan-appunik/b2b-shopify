     data-i18n-recent-activity="{{ 'cartDrawer.recentActivity' | t }}"
     data-i18n-view-all="{{ 'cartDrawer.viewAll' | t }}"
     data-i18n-no-orders-yet="{{ 'cartDrawer.noOrdersYet' | t }}"
     data-i18n-shopping-lists="{{ 'cartDrawer.shoppingLists' | t }}"
     data-i18n-shopping-lists-empty="{{ 'cartDrawer.shoppingListsEmpty' | t }}"
     data-i18n-my-details="{{ 'cartDrawer.myDetails' | t }}"
     data-i18n-email="{{ 'cartDrawer.email' | t }}"
     data-i18n-credit-limit="{{ 'cartDrawer.creditLimit' | t }}"
     data-i18n-available-credit="{{ 'cartDrawer.availableCredit' | t }}"
     data-i18n-net-payment-terms="{{ 'cartDrawer.netPaymentTerms' | t }}"
     data-i18n-not-set="{{ 'cartDrawer.notSet' | t }}"
     data-i18n-payment-terms-note="{{ 'cartDrawer.paymentTermsNote' | t }}"
     data-i18n-reports="{{ 'cartDrawer.reports' | t }}"
     data-i18n-reports-name-column="{{ 'cartDrawer.reportsNameColumn' | t }}"
     data-i18n-purchase-history-report="{{ 'cartDrawer.purchaseHistoryReport' | t }}"
     data-i18n-address-book="{{ 'cartDrawer.addressBook' | t }}"
     data-i18n-default-shipping-address="{{ 'cartDrawer.defaultShippingAddress' | t }}"
     data-i18n-default-billing-address="{{ 'cartDrawer.defaultBillingAddress' | t }}"
     data-i18n-orders-placed-in="{{ 'cartDrawer.ordersPlacedIn' | t }}"
     data-i18n-set-as-default-address="{{ 'cartDrawer.setAsDefaultAddress' | t }}"
     data-i18n-save-address="{{ 'cartDrawer.saveAddress' | t }}"
     data-i18n-activity-all="{{ 'cartDrawer.activityAll' | t }}"
     data-i18n-activity-awaiting-merchant="{{ 'cartDrawer.activityAwaitingMerchant' | t }}"
     data-i18n-activity-order="{{ 'cartDrawer.activityOrder' | t }}"
     data-i18n-activity-reference="{{ 'cartDrawer.activityReference' | t }}"
     data-i18n-activity-submitted-on="{{ 'cartDrawer.activitySubmittedOn' | t }}"
     data-i18n-activity-amount="{{ 'cartDrawer.activityAmount' | t }}"
     data-i18n-activity-status="{{ 'cartDrawer.activityStatus' | t }}"
     {{ block.shopify_attributes }}>
</div>

{% if customer %}
  <script type="application/json" id="sparklayer-customer-addresses">{{ customer.addresses | json }}</script>
  <script type="application/json" id="sparklayer-customer-default-address-id">{{ customer.default_address.id | json }}</script>
{% endif %}

<link rel="stylesheet" href="{{ 'cart-drawer.css' | asset_url }}">
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SparkLayer Cart Drawer",
  "target": "body",
  "settings": []
}
{% endschema %}

{% comment %}
  Wholesale pricing widget for product-card contexts (collection grids,
  "you may also like" carousels, etc.) — theme-agnostic app block.

  Unlike blocks/wholesale-pricing.liquid (built for the PDP buy-box, always
  a per-variant table), this renders a compact card: WSP/MSRP price line,
  one <select> dropdown per product option, a qty stepper, and an Add to
  Cart button — matching the reference "collection grid" design. Works on
  any Online Store 2.0 theme whose product-card block list includes an
  "@app" slot, since it reads the product via block.settings.product
  (autofill) rather than any theme-specific liquid object.

  Guests and non-B2B logged-in customers see a sign-in prompt (same gate as
  wholesale-pricing.liquid).

  Known limitation (shared with wholesale-pricing.liquid): sparklayer.wholesale_price
  is a plain decimal metafield and does not auto-convert under Shopify Markets
  multi-currency storefronts the way native variant.price does.
{% endcomment %}

{% unless block.settings.product == blank %}
  {% assign sl_product = block.settings.product %}
  {% assign sl_variant = sl_product.selected_or_first_available_variant %}
  <div
    id="sparklayer-wholesale-pricing-card-{{ section.id }}-{{ block.id }}"
    class="sparklayer-wholesale-pricing sl-wsp-card"
    data-money-format="{{ shop.money_format | strip_html }}"
    data-currency="{{ localization.country.currency.iso_code | default: cart.currency.iso_code }}"
    data-currency-symbol="{{ localization.country.currency.symbol | default: cart.currency.symbol | default: '$' }}"
    data-i18n-add-to-cart="{{ 'wholesalePricing.addToCart' | t }}"
    data-i18n-add-with-price="{{ 'wholesalePricing.addWithPrice' | t }}"
    data-i18n-sold-out="{{ 'wholesalePricing.soldOut' | t }}"
    {{ block.shopify_attributes }}
  >
    {% if customer.b2b? %}
      {% liquid
        assign active_curr = localization.country.currency.iso_code | default: cart.currency.iso_code | downcase
        assign active_curr_symbol = localization.country.currency.symbol | default: cart.currency.symbol | default: '$'
        if active_curr == 'eur'
          assign active_curr_symbol = '€'
        elsif active_curr == 'gbp'
          assign active_curr_symbol = '£'
        elsif active_curr == 'cad'
          assign active_curr_symbol = 'CA$'
        elsif active_curr == 'aud'
          assign active_curr_symbol = 'AU$'
        elsif active_curr == 'usd'
          assign active_curr_symbol = '$'
        endif
      %}
      <script type="application/json" data-sl-variants>
        [
          {% for variant in sl_product.variants %}
            {% liquid
              assign curr_wsp_key = 'wholesale_price_' | append: active_curr
              assign curr_wsp = variant.metafields.sparklayer[curr_wsp_key].value
              assign wsp = curr_wsp | default: variant.metafields.sparklayer.wholesale_price.value
              if wsp
                assign row_price_cents = wsp | times: 100 | round
              else
                assign row_price_cents = variant.price
              endif

              assign raw_msrp = variant.metafields.sparklayer.msrp.value | default: variant.metafields.custom.msrp.value | default: variant.metafields.sparklayer.rrp.value | default: variant.metafields.custom.rrp.value | default: sl_product.metafields.sparklayer.msrp.value | default: sl_product.metafields.custom.msrp.value
              assign matched_msrp = null

              if raw_msrp != blank
                for item in raw_msrp
                  assign item_curr = item.currency_code | downcase
                  if item_curr == active_curr
                    assign matched_msrp = item.value
                    break
                  endif
                endfor
                if matched_msrp == null
                  for item in raw_msrp
                    assign item_curr = item.currency_code | downcase
                    if item_curr == 'usd'
                      assign matched_msrp = item.value
                      break
                    endif
                  endfor
                endif
                if matched_msrp == null
                  for item in raw_msrp
                    if item.value
                      assign matched_msrp = item.value
                      break
                    endif
                  endfor
                endif
                if matched_msrp == null and raw_msrp.value
                  assign matched_msrp = raw_msrp.value
                elsif matched_msrp == null and raw_msrp > 0
                  assign matched_msrp = raw_msrp
                endif
              endif

              if matched_msrp
                assign card_msrp_cents = matched_msrp | times: 100 | round
              else
                assign card_msrp_cents = null
              endif
            %}
            {
              "id": {{ variant.id | json }},
              "options": {{ variant.options | json }},
              "price": {{ row_price_cents | json }},
              "wsp": {{ wsp | default: null | json }},
              "compareAtPrice": {{ variant.compare_at_price | default: null | json }},
              "nativePrice": {{ variant.price | json }},
              "customMsrp": {{ card_msrp_cents | default: null | json }},
              "msrpRaw": {{ raw_msrp | json }},
              "available": {{ variant.available | json }},
              "tiers": {{ variant.metafields.sparklayer.wholesale_price_tiers.value | default: "[]" }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      </script>

      {% liquid
        assign card_curr_wsp_key = 'wholesale_price_' | append: active_curr
        assign card_sl_wsp = sl_variant.metafields.sparklayer[card_curr_wsp_key].value | default: sl_variant.metafields.sparklayer.wholesale_price.value
        assign sl_raw_msrp = sl_variant.metafields.sparklayer.msrp.value | default: sl_variant.metafields.custom.msrp.value | default: sl_variant.metafields.sparklayer.rrp.value | default: sl_variant.metafields.custom.rrp.value | default: sl_product.metafields.sparklayer.msrp.value | default: sl_product.metafields.custom.msrp.value
        assign sl_matched_msrp = null
        if sl_raw_msrp != blank
          for item in sl_raw_msrp
            assign item_curr = item.currency_code | downcase
            if item_curr == active_curr
              assign sl_matched_msrp = item.value
              break
            endif
          endfor
          if sl_matched_msrp == null
            for item in sl_raw_msrp
              assign item_curr = item.currency_code | downcase
              if item_curr == 'usd'
                assign sl_matched_msrp = item.value
                break
              endif
            endfor
          endif
          if sl_matched_msrp == null
            for item in sl_raw_msrp
              if item.value
                assign sl_matched_msrp = item.value
                break
              endif
            endfor
          endif
          if sl_matched_msrp == null and sl_raw_msrp.value
            assign sl_matched_msrp = sl_raw_msrp.value
          elsif sl_matched_msrp == null and sl_raw_msrp > 0
            assign sl_matched_msrp = sl_raw_msrp
          endif
        endif
        if sl_matched_msrp
          assign sl_msrp_cents = sl_matched_msrp | times: 100 | round
        else
          assign sl_msrp_cents = null
        endif
      %}

      <div class="sl-wsp-price sl-wsp-card-price" data-sl-price>
        {% if card_sl_wsp %}
          <span class="sl-wsp-price-wsp" data-sl-price-primary>{{ 'wholesalePricing.wspPrefix' | t }}{{ card_sl_wsp | times: 100 | money }}</span>
          {% if sl_msrp_cents %}
            {% assign card_msrp_dollars = sl_msrp_cents | divided_by: 100 %}
            {% assign card_msrp_rem = sl_msrp_cents | modulo: 100 | prepend: '00' | slice: -2, 2 %}
            <span class="sl-wsp-price-msrp" data-sl-price-secondary>{{ 'wholesalePricing.msrp' | t }}: {{ active_curr_symbol }}{{ card_msrp_dollars }}.{{ card_msrp_rem }}</span>
          {% else %}
            <span class="sl-wsp-price-msrp" data-sl-price-secondary>{{ 'wholesalePricing.msrp' | t }}: {{ sl_variant.price | money }}</span>
          {% endif %}
        {% else %}
          <span class="sl-wsp-price-wsp" data-sl-price-primary>{{ sl_variant.price | money }}</span>
          {% if sl_msrp_cents %}
            {% assign card_msrp_dollars = sl_msrp_cents | divided_by: 100 %}
            {% assign card_msrp_rem = sl_msrp_cents | modulo: 100 | prepend: '00' | slice: -2, 2 %}
            <span class="sl-wsp-price-msrp" data-sl-price-secondary>{{ 'wholesalePricing.msrp' | t }}: {{ active_curr_symbol }}{{ card_msrp_dollars }}.{{ card_msrp_rem }}</span>
          {% elsif sl_variant.compare_at_price > sl_variant.price %}
            <span class="sl-wsp-price-msrp" data-sl-price-secondary>{{ 'wholesalePricing.msrp' | t }}: {{ sl_variant.compare_at_price | money }}</span>
          {% else %}
            <span class="sl-wsp-price-msrp" data-sl-price-secondary style="display:none;"></span>
          {% endif %}
        {% endif %}
      </div>

      {% for option in sl_product.options_with_values %}
        <div class="sl-wsp-option">
          <label class="sl-wsp-option-label" for="sl-wsp-option-{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <select
            id="sl-wsp-option-{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
            class="sl-wsp-option-select"
            data-sl-option-select
            data-option-index="{{ forloop.index0 }}"
          >
            {% for value in option.values %}
              <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>
                {{ value }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endfor %}

      <div class="sl-wsp-card-buy-row">
        <div class="sl-wsp-stepper">
          <button
            type="button"
            class="sl-wsp-stepper-btn"
            data-sl-step="-1"
            aria-label="{{ 'wholesalePricing.decrease' | t }}"
          >&minus;</button>
          <input
            type="number"
            inputmode="numeric"
            min="0"
            value="1"
            class="sl-wsp-qty-input"
            data-sl-qty-input
            data-variant-id="{{ sl_variant.id }}"
            aria-label="{{ 'wholesalePricing.quantity' | t }}"
          >
          <button
            type="button"
            class="sl-wsp-stepper-btn"
            data-sl-step="1"
            aria-label="{{ 'wholesalePricing.increase' | t }}"
          >+</button>
        </div>

        <button type="button" class="sl-wsp-add-to-cart sl-wsp-card-add" data-sl-add-to-cart>
          <span data-sl-add-to-cart-label>{{ 'wholesalePricing.addToCart' | t }}</span>
        </button>
      </div>

      <div class="visually-hidden" role="status" aria-live="polite" data-sl-live-region></div>
    {% else %}
      <p class="sl-wsp-signin-prompt">
        {{ 'wholesalePricing.signInPromptPrefix' | t }}
        <a href="{{ routes.account_login_url }}">{{ 'wholesalePricing.signInLinkText' | t }}</a>
        {{ 'wholesalePricing.signInPromptSuffix' | t }}
      </p>
    {% endif %}
  </div>

  <link rel="stylesheet" href="{{ 'wholesale-pricing.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'wholesale-pricing-card.css' | asset_url }}">
  <script src="{{ 'wholesale-pricing-card.js' | asset_url }}" defer></script>
{% endunless %}

{% schema %}
{
  "name": "Wholesale Pricing (Card)",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true }
  ]
}
{% endschema %}

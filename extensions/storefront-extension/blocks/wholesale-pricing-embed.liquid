{% comment %}
  Sitewide wholesale-pricing embed — an App Embed (target: "body"), toggled
  ONCE in the theme editor's "App embeds" panel. Unlike wholesale-pricing.liquid
  and wholesale-pricing-card.liquid (both target: "section", requiring manual
  per-section placement), this needs zero placement: once enabled, it injects
  WSP price + variant dropdowns + qty + Add-to-cart into every product-card on
  every page, EXCEPT the product detail page (which already has its own
  dedicated wholesale-pricing.liquid buy-box block — no need to duplicate it).

  Product/variant/WSP data can't come from Liquid `autofill` here (the embed
  doesn't know in advance which products render on a given page), so the
  script fetches it client-side per product handle via the Storefront API,
  using the public access token provisioned by
  admin-frontend/app/services/storefrontToken.server.ts and stored on the
  `sparklayer.storefront_token` shop metafield.

  Gated to B2B customers only (data-is-b2b), same as the other two blocks.
{% endcomment %}

{% unless request.page_type == 'product' %}
  <div
    id="sparklayer-wholesale-pricing-embed"
    data-is-b2b="{{ customer.b2b? }}"
    data-storefront-token="{{ shop.metafields.sparklayer.storefront_token.value }}"
    data-shop-domain="{{ shop.permanent_domain }}"
    data-money-format="{{ shop.money_format | strip_html }}"
    data-i18n-add-to-cart="{{ 'wholesalePricing.addToCart' | t }}"
    data-i18n-add-with-price="{{ 'wholesalePricing.addWithPrice' | t }}"
    data-i18n-sold-out="{{ 'wholesalePricing.soldOut' | t }}"
    hidden
  ></div>

  <link rel="stylesheet" href="{{ 'wholesale-pricing.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'wholesale-pricing-card.css' | asset_url }}">
  <script src="{{ 'wholesale-pricing-embed.js' | asset_url }}" defer></script>
{% endunless %}

{% schema %}
{
  "name": "Wholesale Pricing (All)",
  "target": "body"
}
{% endschema %}
